<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Désactivé pour simplifier : pas d'avertissements sur les valeurs « null ». -->
    <Nullable>disable</Nullable>
    <RootNamespace>CroustyClickCollect</RootNamespace>
  </PropertyGroup>

  <!-- Les deux seules bibliothèques ajoutées au projet. -->
  <ItemGroup>
    <!-- MySqlConnector : permet au code C# de se connecter à MySQL / MariaDB. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- Dapper : transforme chaque ligne d'un résultat SQL en objet C#. -->
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

</Project>
