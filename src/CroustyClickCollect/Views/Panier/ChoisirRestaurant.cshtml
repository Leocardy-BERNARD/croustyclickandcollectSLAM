@model List<Restaurant>
@{
    ViewData["Title"] = "Choisir mon restaurant";
}

<h1>Où voulez-vous retirer votre commande ?</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        Aucun restaurant pour l'instant : écrivez le TODO S2-01 (Data/RestaurantRepository.cs).
    </div>
}

<div class="row g-3">
    @foreach (Restaurant restaurant in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">@restaurant.Nom</h2>
                    <p>@restaurant.Adresse, @restaurant.Ville</p>
                    <form asp-action="ChoisirRestaurant" method="post">
                        <input type="hidden" name="restaurantId" value="@restaurant.Id" />
                        <button type="submit" class="btn btn-dark">Choisir ce restaurant</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
