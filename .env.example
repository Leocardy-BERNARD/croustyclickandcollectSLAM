# =====================================================================
#  MODÈLE du fichier .env
#  1. Copiez ce fichier et nommez la copie « .env » (dans le même dossier).
#  2. Adaptez les valeurs si besoin (voir README > Installation).
#
#  BONNE PRATIQUE (bloc 3) : les mots de passe ne sont jamais écrits dans
#  le code. Ils sont dans .env, qui n'est jamais envoyé sur GitHub
#  (il est listé dans .gitignore). Ce fichier-ci (.env.example) ne contient
#  que des valeurs de développement : il peut être partagé sans risque.
# =====================================================================

# Adresse et port du serveur MySQL / MariaDB (127.0.0.1 = « cet ordinateur »)
DB_HOST=127.0.0.1
DB_PORT=3306

# Nom de la base créée par sql/01-schema.sql
DB_NAME=crousty

# Compte MySQL du site, créé par sql/03-utilisateur-app.sql
# (mot de passe de développement : valable seulement sur votre poste)
DB_USER=crousty_app
DB_PASSWORD=crousty_dev_2026
